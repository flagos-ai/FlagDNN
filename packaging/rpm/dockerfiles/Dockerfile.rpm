ARG BASE_IMAGE=nvidia/cuda:12.6.0-devel-rockylinux9
FROM ${BASE_IMAGE}

RUN dnf install -y epel-release dnf-plugins-core \
    && (dnf config-manager --set-enabled crb 2>/dev/null \
        || dnf config-manager --set-enabled powertools 2>/dev/null \
        || true) \
    && dnf install -y --allowerasing \
        cmake fmt-devel gcc-c++ git json-devel ninja-build patchelf \
        python3-devel python3-pip python3-pyyaml rpm-build rpmdevtools \
    && dnf clean all

RUN python3 -m pip install --no-cache-dir \
    "pybind11==3.1.0" "torch==2.8.0" "triton==3.4.0"

# Fallback source for libtriton-jit-nvidia when local-deps/ is empty: the
# repository the package is published to (the yum repositories are per
# distribution; this build image is EL9).
ARG FLAGOS_YUM=https://resource.flagos.net/repository/flagos-yum-rhel9

COPY packaging/rpm/local-deps/ /tmp/local-deps/
RUN if ls /tmp/local-deps/libtriton-jit-nvidia*.rpm >/dev/null 2>&1; then \
        dnf install -y /tmp/local-deps/libtriton-jit-nvidia-[0-9]*.rpm \
          /tmp/local-deps/libtriton-jit-nvidia-devel-*.rpm; \
    else \
        printf '[flagos]\nname=FlagOS\nbaseurl=%s\nenabled=1\ngpgcheck=0\n' \
          "${FLAGOS_YUM}" > /etc/yum.repos.d/flagos.repo; \
        dnf install -y libtriton-jit-nvidia-devel; \
    fi \
    && dnf clean all

RUN rpmdev-setuptree

COPY . /workspace/FlagDNN
WORKDIR /workspace/FlagDNN

RUN v=$(awk '/^Version:/{print $2}' packaging/rpm/specs/flag-dnn.spec) \
    && tar czf /root/rpmbuild/SOURCES/flag-dnn-${v}.tar.gz \
        --transform "s,^[.],flag-dnn-${v}," \
        --exclude='.git' --exclude='build' --exclude='debian-packages' \
        --exclude='rpm-packages' .

RUN rpmbuild -ba packaging/rpm/specs/flag-dnn.spec

RUN mkdir -p /output \
    && find /root/rpmbuild/RPMS -name "*.rpm" -exec cp {} /output/ \; \
    && find /root/rpmbuild/SRPMS -name "*.rpm" -exec cp {} /output/ \; \
    && ls -lh /output/
