ARG BASE_IMAGE=nvidia/cuda:12.8.0-devel-ubuntu24.04
FROM ${BASE_IMAGE}

ARG PYTHON_VERSION=3.12
ARG TORCH_INDEX=https://resource.flagos.net/repository/flagos-pypi-nvidia/simple
ARG TORCH_PACKAGES="torch==2.10.0+cu128 triton==3.6.0"

# Ubuntu 24.04 marks its system Python as externally managed (PEP 668), which
# stops get-pip.py and every pip install below. This is a throwaway build
# container, so installing into the system Python is what is wanted.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl debhelper devscripts dpkg-dev \
        fakeroot git libfmt-dev ninja-build nlohmann-json3-dev patchelf \
        software-properties-common \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN if ! command -v python${PYTHON_VERSION} >/dev/null 2>&1; then \
        (add-apt-repository -y ppa:deadsnakes/ppa \
            || add-apt-repository -y ppa:deadsnakes/ppa); \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} python${PYTHON_VERSION}-dev \
        python${PYTHON_VERSION}-venv \
    && update-alternatives --install /usr/bin/python3 python3 \
        /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --install /usr/bin/python python \
        /usr/bin/python${PYTHON_VERSION} 1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
        "cmake>=3.25,<4.0" "pybind11==3.0.3" "PyYAML" \
    && python3 -m pip install --no-cache-dir \
        --index-url "${TORCH_INDEX}" ${TORCH_PACKAGES}

# libtriton-jit comes from packaging/debian/local-deps/ when a build drops
# the .deb files there, otherwise from the FlagOS apt repository for the base
# image's Ubuntu release (one repository per release, suite = codename),
# added the way a user adds it, signature checked against the published key.
ARG FLAGOS_APT_BASE=https://resource.flagos.net/repository
ARG FLAGOS_APT_KEY=https://resource.flagos.net/repository/apt-keys/pub/flagos-apt-public-key.asc
COPY packaging/debian/local-deps/ /tmp/local-deps/
RUN if ls /tmp/local-deps/libtriton-jit-nvidia*.deb >/dev/null 2>&1; then \
        apt-get update && apt-get install -y /tmp/local-deps/*.deb; \
    else \
        . /etc/os-release; \
        install -d -m 0755 /etc/apt/keyrings; \
        curl -fsSL "${FLAGOS_APT_KEY}" -o /etc/apt/keyrings/flagos.asc; \
        echo "deb [signed-by=/etc/apt/keyrings/flagos.asc] ${FLAGOS_APT_BASE}/flagos-apt-ubuntu${VERSION_ID} ${VERSION_CODENAME} main" \
          > /etc/apt/sources.list.d/flagos.list; \
        apt-get update; \
        apt-get install -y libtriton-jit-nvidia-dev; \
    fi \
    && rm -rf /var/lib/apt/lists/*

COPY . /workspace/FlagDNN
WORKDIR /workspace/FlagDNN

RUN cp -r packaging/debian debian
RUN dpkg-buildpackage -us -uc -b -d

RUN install -d /output \
    && find /output -mindepth 1 -delete \
    && find /workspace -maxdepth 1 -name "libflagdnn*.deb" -exec cp {} /output/ \; \
    && find /workspace -maxdepth 1 -name "flag-dnn_*.changes" -exec cp {} /output/ \; \
    && ls -lh /output/
