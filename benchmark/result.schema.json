{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagdnn.example/schemas/native-benchmark-result-v1.json",
  "title": "FlagDNN native benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "provider",
    "case",
    "unit",
    "median",
    "p90",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "steady_state"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "const": "us"
    },
    "median": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "p90": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  }
}
