{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagdnn.example/schemas/native-benchmark-result-v6.json",
  "title": "FlagDNN native benchmark result",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"},
    {"$ref": "#/$defs/v3"},
    {"$ref": "#/$defs/v4"},
    {"$ref": "#/$defs/v5"},
    {"$ref": "#/$defs/v6"}
  ],
  "$defs": {
    "positiveSamples": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median", "p90", "samples"],
      "properties": {
        "median": {"type": "number", "exclusiveMinimum": 0},
        "p90": {"type": "number", "exclusiveMinimum": 0},
        "samples": {"$ref": "#/$defs/positiveSamples"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soc_fingerprint",
        "cann_package_version",
        "ascendcl_build_id",
        "runtime_build_id"
      ],
      "properties": {
        "soc_fingerprint": {"type": "string", "minLength": 1},
        "cann_package_version": {"type": "string", "minLength": 1},
        "ascendcl_build_id": {"type": "string", "minLength": 1},
        "runtime_build_id": {"type": "string", "minLength": 1}
      }
    },
    "benchmarkConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_iterations",
        "sample_count",
        "iterations_per_sample"
      ],
      "properties": {
        "warmup_iterations": {"type": "integer", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 1},
        "iterations_per_sample": {"type": "integer", "minimum": 1}
      }
    },
    "flagdnnIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "libtriton_jit_sha256",
        "compiler_identity_sha256",
        "artifact_request_sha256",
        "launch_abi",
        "selected_candidate"
      ],
      "properties": {
        "libtriton_jit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compiler_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "launch_abi": {"const": "ltj_npu_raw_v1"},
        "selected_candidate": {"type": "string", "minLength": 1}
      }
    },
    "aclnnIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["libnnopbase_sha256", "libopapi_math_sha256"],
      "properties": {
        "libnnopbase_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "libopapi_math_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "libopapi_nn_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "provider",
        "case",
        "unit",
        "median",
        "p90",
        "samples"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "steady_state"},
        "provider": {"type": "string", "minLength": 1},
        "case": {"type": "string", "minLength": 1},
        "unit": {"const": "us"},
        "median": {"type": "number", "exclusiveMinimum": 0},
        "p90": {"type": "number", "exclusiveMinimum": 0},
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "v5": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "provider", "case", "unit",
        "median", "p90", "samples", "timing_mode", "timing_reason",
        "benchmark_config"
      ],
      "properties": {
        "schema_version": {"const": 5},
        "kind": {"const": "steady_state"},
        "provider": {"enum": ["flagdnn", "hipdnn"]},
        "case": {"type": "string", "minLength": 1},
        "unit": {"const": "us"},
        "median": {"type": "number", "exclusiveMinimum": 0},
        "p90": {"type": "number", "exclusiveMinimum": 0},
        "samples": {"$ref": "#/$defs/positiveSamples"},
        "timing_mode": {"enum": ["hip_graph_batch", "hip_event_direct_batch"]},
        "timing_reason": {"enum": ["standard", "hipdnn_graph_tail_workaround"]},
        "benchmark_config": {"$ref": "#/$defs/benchmarkConfig"}
      },
      "allOf": [{
        "if": {"properties": {"timing_mode": {"const": "hip_graph_batch"}}},
        "then": {"properties": {"timing_reason": {"const": "standard"}}},
        "else": {"properties": {"timing_reason": {"const": "hipdnn_graph_tail_workaround"}}}
      }]
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "provider",
        "case",
        "environment",
        "provider_identity",
        "benchmark_config",
        "stream_us",
        "submit_us",
        "end_to_end_us"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "kind": {"const": "steady_state"},
        "provider": {"enum": ["flagdnn", "aclnn"]},
        "case": {"type": "string", "minLength": 1},
        "environment": {"$ref": "#/$defs/environment"},
        "provider_identity": {
          "oneOf": [
            {"$ref": "#/$defs/flagdnnIdentity"},
            {"$ref": "#/$defs/aclnnIdentity"}
          ]
        },
        "benchmark_config": {"$ref": "#/$defs/benchmarkConfig"},
        "stream_us": {"$ref": "#/$defs/metric"},
        "submit_us": {"$ref": "#/$defs/metric"},
        "end_to_end_us": {"$ref": "#/$defs/metric"}
      },
      "allOf": [
        {
          "if": {"properties": {"provider": {"const": "flagdnn"}}},
          "then": {
            "properties": {
              "provider_identity": {"$ref": "#/$defs/flagdnnIdentity"}
            }
          }
        },
        {
          "if": {"properties": {"provider": {"const": "aclnn"}}},
          "then": {
            "properties": {
              "provider_identity": {"$ref": "#/$defs/aclnnIdentity"}
            }
          }
        }
      ]
    },
    "equivalentBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "platform", "target_platform", "scale_metric", "timing_profile",
        "reference_time_us", "reference_peak", "target_peak",
        "min_relative_efficiency", "equivalent_time_us", "limit_us",
        "relative_efficiency", "passed"
      ],
      "properties": {
        "provider": {"const": "nvidia_equivalent"},
        "platform": {"const": "nvidia"},
        "target_platform": {"enum": ["hygon", "mthreads"]},
        "scale_metric": {"enum": ["vector_fp32", "hbm_copy", "hbm_write", "hbm_triad"]},
        "timing_profile": {"enum": ["native", "batchnorm_training"]},
        "traffic_ratio": {"type": "number", "exclusiveMinimum": 0, "default": 1},
        "reference_validation": {
          "enum": ["cpu_full", "cpu_sampled", "bit_exact", "sanity"],
          "default": "cpu_full"
        },
        "reference_time_us": {"type": "number", "exclusiveMinimum": 0},
        "reference_peak": {"type": "number", "exclusiveMinimum": 0},
        "target_peak": {"type": "number", "exclusiveMinimum": 0},
        "min_relative_efficiency": {
          "type": "number", "exclusiveMinimum": 0, "maximum": 1
        },
        "equivalent_time_us": {"type": "number", "exclusiveMinimum": 0},
        "limit_us": {"type": "number", "exclusiveMinimum": 0},
        "relative_efficiency": {"type": "number", "exclusiveMinimum": 0},
        "passed": {"type": "boolean"}
      },
      "allOf": [{
        "if": {"properties": {"scale_metric": {"const": "vector_fp32"}}},
        "then": {"properties": {"traffic_ratio": {"const": 1}}}
      }]
    },
    "v4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "provider", "case", "unit",
        "median", "p90", "samples", "equivalent_baseline"
      ],
      "properties": {
        "schema_version": {"const": 4},
        "kind": {"const": "steady_state"},
        "provider": {"const": "flagdnn"},
        "case": {
          "type": "string",
          "pattern": "^(?:(?:relu_backward|swish_backward)_attributes_(?:fp32|fp16|bfloat16)_|identity_(?:fp8_(?:e4m3|e5m2)|bfloat16|int32|bool)_|identity_perf_bfloat16_|batchnorm_perf_(?:fp16|bfloat16)_|reduction_(?:sum_bfloat16|(?:sum|avg|mul)_fp16)_to_fp32_|(?:abs|add|add_square|elu|max|min|mul|relu|relu_backward|scale|sigmoid|sigmoid_backward|sub|swish|swish_backward|tanh|tanh_backward)_perf_bfloat16_|(?:reshape|transpose|slice|concatenate|gen_index|div|pow|mod|cmp_eq|cmp_neq|cmp_gt|cmp_ge|cmp_lt|cmp_le|logical_and|logical_or|logical_not|binary_select|neg|sqrt|rsqrt|reciprocal|ceil|floor|exp|log|erf|sin|cos|tan|leaky_relu|leaky_relu_backward|elu_backward|gelu|gelu_backward|gelu_approx_tanh|gelu_approx_tanh_backward|softplus|softplus_backward)_(?:(?:perf|attributes)_)?(?:fp32|fp16|bfloat16|bf16|bool|int32)_(?:case[0-9]+_)?)[0-9][a-z0-9_-]*$"
        },
        "unit": {"const": "us"},
        "median": {"type": "number", "exclusiveMinimum": 0},
        "p90": {"type": "number", "exclusiveMinimum": 0},
        "samples": {"$ref": "#/$defs/positiveSamples"},
        "equivalent_baseline": {"$ref": "#/$defs/equivalentBaseline"}
      },
      "allOf": [{
        "if": {"properties": {"equivalent_baseline": {"properties": {
          "target_platform": {"const": "mthreads"}
        }}}},
        "then": {"allOf": [{
          "if": {"properties": {"case": {"pattern": "^(?:relu_backward|leaky_relu_backward)_attributes_"}}},
          "then": {"properties": {"equivalent_baseline": {"properties": {
            "scale_metric": {"const": "hbm_triad"}
          }}}},
          "else": {"properties": {"equivalent_baseline": {"properties": {
            "scale_metric": {"const": "vector_fp32"}
          }}}}
        }], "properties": {
          "case": {"pattern": "^(?:(?:elu_backward|softplus_backward)_perf_|(?:relu_backward|leaky_relu_backward|swish_backward)_attributes_)(?:fp32|fp16|bfloat16)_[0-9][a-z0-9_]*$"},
          "equivalent_baseline": {"properties": {
            "scale_metric": {"enum": ["vector_fp32", "hbm_triad"]},
            "min_relative_efficiency": {"minimum": 0.8},
            "traffic_ratio": {"const": 1},
            "reference_validation": {"const": "cpu_full"}
          }}
        }}
      }, {
        "if": {"properties": {"case": {"pattern": "^(?:relu_backward|swish_backward)_attributes_"}}},
        "then": {"properties": {"equivalent_baseline": {"properties": {
          "target_platform": {"const": "mthreads"}
        }}}}
      }, {
        "if": {"not": {"properties": {"case": {"pattern": "^div_"}}}},
        "then": {
          "properties": {
            "equivalent_baseline": {"required": ["traffic_ratio", "reference_validation"]}
          }
        }
      }, {
        "if": {"properties": {"case": {"pattern": "^identity_"}}},
        "then": {
          "properties": {
            "equivalent_baseline": {
              "properties": {
                "scale_metric": {"const": "hbm_copy"}
              }
            }
          }
        }
      }, {
        "if": {"properties": {"case": {"pattern": "^identity_perf_"}}},
        "then": {"properties": {"equivalent_baseline": {"properties": {
          "reference_validation": {"const": "cpu_full"}
        }}}},
        "else": {
          "if": {"properties": {"case": {"pattern": "^identity_"}}},
          "then": {"properties": {"equivalent_baseline": {"properties": {
            "reference_validation": {"const": "bit_exact"}
          }}}}
        }
      }, {
        "if": {"properties": {"case": {"pattern": "^identity_bool_"}}},
        "then": {"properties": {"equivalent_baseline": {"properties": {
          "traffic_ratio": {"const": 8}
        }}}},
        "else": {
          "if": {"properties": {"case": {"pattern": "^identity_"}}},
          "then": {"properties": {"equivalent_baseline": {"properties": {
            "traffic_ratio": {"const": 1}
          }}}}
        }
      }, {
        "if": {"properties": {"case": {"pattern": "^(?:(?:abs|add|add_square|elu|max|min|mul|relu|relu_backward|scale|sigmoid|sigmoid_backward|sub|swish|swish_backward|tanh|tanh_backward)_perf_bfloat16_|batchnorm_perf_|reduction_)"}}},
        "then": {"properties": {"equivalent_baseline": {"properties": {
          "reference_validation": {"const": "cpu_full"},
          "traffic_ratio": {"const": 1}
        }}}}
      }, {
        "if": {"properties": {"case": {"pattern": "^batchnorm_"}}},
        "then": {"properties": {
          "samples": {"minItems": 10, "maxItems": 10},
          "equivalent_baseline": {"properties": {
            "timing_profile": {"const": "batchnorm_training"}
          }}
        }},
        "else": {"properties": {
          "samples": {"minItems": 20, "maxItems": 20},
          "equivalent_baseline": {"properties": {
            "timing_profile": {"const": "native"}
          }}
        }}
      }]
    },
    "v3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "provider", "case", "unit",
        "median", "p90", "samples", "host_submit_us", "build_us",
        "warm_build_us", "workspace_bytes", "build_cache"
      ],
      "properties": {
        "schema_version": {"const": 3},
        "kind": {"const": "steady_state"},
        "provider": {"enum": ["flagdnn", "cudnn"]},
        "case": {"type": "string", "minLength": 1},
        "unit": {"const": "us"},
        "median": {"type": "number", "exclusiveMinimum": 0},
        "p90": {"type": "number", "exclusiveMinimum": 0},
        "samples": {"$ref": "#/$defs/positiveSamples"},
        "host_submit_us": {"$ref": "#/$defs/metric"},
        "build_us": {"type": "number", "exclusiveMinimum": 0},
        "warm_build_us": {"type": "number", "exclusiveMinimum": 0},
        "workspace_bytes": {"type": "integer", "minimum": 0},
        "comparison": {"const": "none"},
        "build_cache": {
          "enum": ["fresh_artifact_cache", "reuse_allowed", "provider_managed"]
        }
      },
      "allOf": [{
        "if": {"required": ["comparison"]},
        "then": {"properties": {
          "provider": {"const": "flagdnn"},
          "case": {"type": "string", "pattern": "^native/.+"}
        }}
      }]
    },
    "v6": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "provider",
        "case",
        "environment",
        "provider_identity",
        "benchmark_config",
        "stream_us",
        "submit_us",
        "end_to_end_us",
        "equivalent_baseline"
      ],
      "properties": {
        "schema_version": {
          "const": 6
        },
        "kind": {
          "const": "steady_state"
        },
        "provider": {
          "const": "flagdnn"
        },
        "case": {
          "type": "string",
          "pattern": "^identity_fp8_(e4m3|e5m2)_.+$"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "provider_identity": {
          "$ref": "#/$defs/flagdnnIdentity"
        },
        "benchmark_config": {
          "const": {
            "warmup_iterations": 10,
            "sample_count": 20,
            "iterations_per_sample": 50,
            "timing_method": "device_events_over_ascend_graph",
            "graph_warmup_replays": 1,
            "statistic": "nearest_rank_p50"
          }
        },
        "stream_us": {
          "allOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "properties": {
                "samples": {
                  "minItems": 20,
                  "maxItems": 20
                }
              }
            }
          ]
        },
        "submit_us": {
          "allOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "properties": {
                "samples": {
                  "minItems": 20,
                  "maxItems": 20
                }
              }
            }
          ]
        },
        "end_to_end_us": {
          "allOf": [
            {
              "$ref": "#/$defs/metric"
            },
            {
              "properties": {
                "samples": {
                  "minItems": 20,
                  "maxItems": 20
                }
              }
            }
          ]
        },
        "equivalent_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "reference_platform",
            "target_platform",
            "reference_case",
            "scale_metric",
            "timing_profile",
            "traffic_ratio",
            "reference_validation",
            "passed",
            "reference_time_us",
            "reference_peak",
            "target_peak",
            "equivalent_time_us",
            "limit_us",
            "relative_efficiency",
            "min_relative_efficiency"
          ],
          "properties": {
            "provider": {
              "const": "nvidia_equivalent"
            },
            "reference_platform": {
              "const": "nvidia"
            },
            "target_platform": {
              "const": "ascend"
            },
            "reference_case": {
              "type": "string",
              "pattern": "^identity_fp8_(e4m3|e5m2)_.+$"
            },
            "scale_metric": {
              "const": "hbm_copy"
            },
            "timing_profile": {
              "const": "native"
            },
            "traffic_ratio": {
              "const": 1
            },
            "reference_validation": {
              "const": "bit_exact"
            },
            "passed": {
              "type": "boolean"
            },
            "reference_time_us": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reference_peak": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "target_peak": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "equivalent_time_us": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "limit_us": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "relative_efficiency": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_relative_efficiency": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
